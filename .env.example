# Скопируйте этот файл в .env и заполните значения

# --- Сервер ---
# Next.js слушает 0.0.0.0:4000 (см. package.json) — сайт, API (/api) и интеграция (/integration/v1)
HOSPITAL_NAME="Արմենիա Բժշկական Կենտրոն"
HOSPITAL_ADDRESS="Երևան, Մաշտոցի պող. 1"

# --- База ---
DATABASE_URL="file:./dev.db"
# PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/hospital"

# --- Auth ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Аптека (сервер Милены) ---
# IP компьютера Милены в локальной сети (или http://localhost:5000 для mock-сервера)
PHARMACY_API_URL=http://localhost:5000
# Ключ, с которым МЫ обращаемся к аптеке (его даёт Милена)
PHARMACY_API_KEY=pharmacy-key-from-milena
# Ключ, с которым АПТЕКА обращается к нам (его даём мы)
INTEGRATION_API_KEY=hospital-key-for-milena

# --- AI Chatbot ---
# Пусто — работает fallback по ключевым словам
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Email-напоминания (необязательно) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hospital <no-reply@hospital.am>"
# Отключить cron напоминаний: REMINDERS_ENABLED=false
REMINDERS_ENABLED=true

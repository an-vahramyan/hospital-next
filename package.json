{
  "name": "hospital-next",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 4000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 4000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "pharmacy:mock": "node integration/mock-pharmacy-server/server.mjs",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "~6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  }
}
